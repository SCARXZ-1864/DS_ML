# Copy to .env (local) and fill in. NEVER commit real values.
# Production values live in Vercel / Modal / GitHub secret stores.

# ---------- web (Next.js, server-side only) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only; never prefix with NEXT_PUBLIC_
INFERENCE_URL=                      # e.g. https://<workspace>--review-intel-inference.us-east.modal.run
INFERENCE_API_KEY=                  # shared secret with the inference service
LLM_PROVIDER=google                 # google | anthropic | groq
LLM_MODEL=                          # e.g. a Gemini Flash model id
GOOGLE_GENERATIVE_AI_API_KEY=
CRON_SECRET=                        # protects /api/cron/keepalive
CHAT_RATE_LIMIT_PER_HOUR=10
CHAT_DAILY_LIMIT=300

# ---------- inference (Modal secret "review-intel-inference") ----------
# INFERENCE_API_KEY (same value as above)
LOG_LEVEL=info

# ---------- pipeline (local / Colab) ----------
HF_TOKEN=                           # write token for pushing models
DATABASE_URL=                       # Supabase Postgres connection string for the loader
